+fn has_osc8_link(
+    cells: &[HyperlinkPosition],
+    viewport: &VecDeque<Row>,
+    lines_above: &VecDeque<Row>,
+) -> bool {
+    cells.iter().any(|cell| {
+        let row = if cell.y < 0 {
+            usize::try_from(lines_above.len() as isize + cell.y)
+                .ok()
+                .and_then(|index| lines_above.get(index))
+        } else {
+            viewport.get(cell.y as usize)
+        };
+        row.is_some_and(|row| {
+            let index = row.absolute_character_index(cell.x.max(0) as usize);
+            matches!(
+                row.columns
+                    .get(index)
+                    .and_then(|character| character.styles.link_anchor),
+                Some(LinkAnchor::Start(_))
+            )
+        })
+    })
+}

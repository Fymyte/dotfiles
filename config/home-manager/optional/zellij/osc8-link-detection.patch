+fn has_osc8_link(
+    lines_above: &VecDeque<Row>,
+    viewport: &VecDeque<Row>,
+    cells: &[Cell],
+    link_handler: &LinkHandler,
+) -> bool {
+    cells.iter().any(|cell| {
+        row_ref(lines_above, viewport, cell.y)
+            .and_then(|row| row.columns.get(cell.index))
+            .and_then(|character| character.styles.link_anchor)
